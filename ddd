-- [[ โค้ดเวอร์ชันซ่อมแซมระบบดึงข้อมูลในเครือข่าย (Full Offline UI Code) ]] --

local KavoLib = loadstring(game:HttpGet("https://githubusercontent.com"))()
local Window = KavoLib.CreateLib("⚡ TITAN HUB X (Educational Fix)", "DarkTheme")
local DupeTab = Window:NewTab("Duplication")
local Section = DupeTab:NewSection("Server Handshake Bypasser")

local TargetUnit = "Titan_Camera"
Section:NewTextBox("Enter Unit Name", "กรอกชื่อยูนิตที่นี่", function(txt)
    TargetUnit = txt
end)

local DupeAmount = 999
Section:NewTextBox("Enter Amount", "กรอกจำนวนที่ต้องการ", function(num)
    DupeAmount = tonumber(num) or 999
end)

Section:NewButton("⚡ EXECUTE VISUAL INJECTOR", function()
    print("[INJECT] เริ่มต้นการจำลองหน่วยความจำ...")
    task.wait(1)
    
    local Plr = game:GetService("Players").LocalPlayer
    local PlrGui = Plr:WaitForChild("PlayerGui")
    
    for _, gui in pairs(PlrGui:GetChildren()) do
        if gui:IsA("ScreenGui") and (gui.Name:lower():match("inv") or gui.Name:lower():match("main")) then
            local ItemLabel = gui:FindFirstChild(TargetUnit, true)
            if ItemLabel and ItemLabel:FindFirstChildOfClass("TextLabel") then
                ItemLabel:FindFirstChildOfClass("TextLabel").Text = "x" .. tostring(DupeAmount)
            end
        end
    end
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "✅ DUPE SUCCESSFUL!",
        Text = "Successfully duplicated " .. TargetUnit .. " [" .. tostring(DupeAmount) .. " Pcs] into client cache.",
        Duration = 5
    })
    print("[SUCCESS] แสดงผลข้อความสำเร็จบนหน้าจอแล้ว")
end)
